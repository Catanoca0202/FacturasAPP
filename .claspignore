# clasp pushes every .js/.html under rootDir unless ignored.
# Apps Script has a single global scope, so any stray script (e.g. the Node
# simulator in Docs/ejemplos) collides with real code and breaks the whole project.
# Strategy: ignore everything, then allow only the root-level source files.
**/**
!appsscript.json
!*.js
!*.html

# Local test scripts, API keys and logs: never pushed (must stay last to win over the !*.js rule)
scratch/**
